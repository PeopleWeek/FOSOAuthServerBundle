{
    "name": "friendsofsymfony/oauth-server-bundle",
    "description": "OAuth2 server bundle for Symfony 6.4 and 7.4",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "oauth",
        "oauth2",
        "server"
    ],
    "authors": [
        {
            "name": "Arnaud Le Blanc",
            "email": "arnaud.lb@gmail.com"
        },
        {
            "name": "FriendsOfSymfony Community",
            "homepage": "https://github.com/FriendsOfSymfony/FOSOAuthServerBundle/contributors"
        }
    ],
    "homepage": "http://friendsofsymfony.github.com",
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:PeopleWeek/oauth2-php.git"
        }
    ],
    "require": {
        "php": "^8.1",
        "friendsofsymfony/oauth2-php": "dev-master",
        "symfony/config": "^6.4 || ^7.4",
        "symfony/console": "^6.4 || ^7.4",
        "symfony/dependency-injection": "^6.4 || ^7.4",
        "symfony/event-dispatcher": "^6.4 || ^7.4",
        "symfony/framework-bundle": "^6.4 || ^7.4",
        "symfony/http-foundation": "^6.4 || ^7.4",
        "symfony/http-kernel": "^6.4 || ^7.4",
        "symfony/password-hasher": "^6.4 || ^7.4",
        "symfony/routing": "^6.4 || ^7.4",
        "symfony/security-bundle": "^6.4 || ^7.4",
        "symfony/security-core": "^6.4 || ^7.4",
        "symfony/security-http": "^6.4 || ^7.4",
        "symfony/twig-bundle": "^6.4 || ^7.4"
    },
    "require-dev": {
        "doctrine/annotations": "^1.14",
        "doctrine/doctrine-bundle": "^2.0",
        "doctrine/mongodb-odm": "^2.2",
        "doctrine/orm": "~2.2",
        "phing/phing": "~2.4",
        "php-mock/php-mock-phpunit": "^2.5",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^9.6",
        "rector/rector": "^2.0",
        "symfony/form": "^6.4 || ^7.4",
        "symfony/phpunit-bridge": "^6.4 || ^7.4",
        "symfony/yaml": "^6.4 || ^7.4"
    },
    "suggest": {
        "doctrine/doctrine-bundle": "*",
        "doctrine/mongodb-odm-bundle": "*",
        "symfony/console": "Needed to be able to use commands",
        "symfony/form": "Needed to be able to use the AuthorizeFormType"
    },
    "autoload": {
        "psr-4": {
            "FOS\\OAuthServerBundle\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.0.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
